soong_namespace {
    imports: ["hardware/google/pixel",
    ],
}

cc_library_headers {
    name: "imx_power_headers",
    vendor: true,
    export_include_dirs: ["."],
}

cc_binary {
    name: "android.hardware.power-service.imx",
    relative_install_path: "hw",
    init_rc: ["android.hardware.power-service.imx.rc"],
    vintf_fragments: ["android.hardware.power-service.imx.xml"],
    vendor: true,
    shared_libs: [
        "android.hardware.power-V6-ndk",
        "libbase",
        "libcutils",
        "liblog",
        "libfmq",
        "libutils",
        "libbinder_ndk",
        "libperfmgr",
        "libprocessgroup",
    ],

    static_libs: [
        "libgmock",
        "libgtest",
        "powerhal_flags-aconfig-cc",
    ],

    srcs: [
        "SupportManager.cpp",
        "SessionChannel.cpp",
        "ChannelGroup.cpp",
        "ChannelManager.cpp",
        "BackgroundWorker.cpp",
        "PowerSessionManager.cpp",
        "SessionRecords.cpp",
        "SessionTaskMap.cpp",
        "SessionValueEntry.cpp",
        "UClampVoter.cpp",
        "service.cpp",
        "Power.cpp",
        "PowerHintSession.cpp",
    ],
}
