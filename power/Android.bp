package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Build powerhal aconfig flags locally (was in hardware/google/pixel)
aconfig_declarations {
    name: "powerhal_flags-aconfig",
    container: "vendor",
    package: "powerhal.flags",
    exportable: true,
    srcs: ["flags.aconfig"],
}

cc_aconfig_library {
    name: "powerhal_flags-aconfig-cc",
    aconfig_declarations: "powerhal_flags-aconfig",
    vendor: true,
}

// Build libperfmgr locally (was in hardware/google/pixel/power-libperfmgr/libperfmgr)
cc_library {
    name: "libperfmgr",
    vendor_available: true,
    local_include_dirs: ["libperfmgr/include"],
    export_include_dirs: ["libperfmgr/include"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libprocessgroup",
        "libutils",
        "liblog",
    ],
    static_libs: [
        "libjsoncpp",
        "libaconfig_storage_read_api_cc",
        "powerhal_flags-aconfig-cc",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    srcs: [
        "libperfmgr/RequestGroup.cc",
        "libperfmgr/Node.cc",
        "libperfmgr/FileNode.cc",
        "libperfmgr/PropertyNode.cc",
        "libperfmgr/NodeLooperThread.cc",
        "libperfmgr/HintManager.cc",
        "libperfmgr/AdpfConfig.cc",
        "libperfmgr/EventNode.cc",
        "libperfmgr/JobQueueManager.cc",
        "libperfmgr/FlagProvider.cc",
    ],
}

cc_library_headers {
    name: "imx_power_headers",
    vendor: true,
    export_include_dirs: ["."],
}

cc_binary {
    name: "android.hardware.power-service.imx",
    relative_install_path: "hw",
    init_rc: ["android.hardware.power-service.imx.rc"],
    vintf_fragments: ["android.hardware.power-service.imx.xml"],
    vendor: true,
    shared_libs: [
        "android.hardware.power-V7-ndk",
        "libbase",
        "libcutils",
        "liblog",
        "libfmq",
        "libutils",
        "libbinder_ndk",
        "libperfmgr",
        "libprocessgroup",
    ],

    static_libs: [
        "libgmock",
        "libgtest",
        "powerhal_flags-aconfig-cc",
    ],

    srcs: [
        "SupportManager.cpp",
        "SessionChannel.cpp",
        "ChannelGroup.cpp",
        "ChannelManager.cpp",
        "BackgroundWorker.cpp",
        "PowerSessionManager.cpp",
        "SessionRecords.cpp",
        "SessionTaskMap.cpp",
        "SessionValueEntry.cpp",
        "UClampVoter.cpp",
        "service.cpp",
        "Power.cpp",
        "PowerHintSession.cpp",
    ],
}
