package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

soong_config_module_type {
    name: "IMXPLUGIN_cc_conditionals",
    module_type: "cc_defaults",
    config_namespace: "IMXPLUGIN",
    variables: ["BOARD_SOC_TYPE", "MEDIA_PIPELINE"],
    properties: ["cflags", "srcs", "shared_libs", "include_dirs"],
}

soong_config_string_variable {
    name: "BOARD_SOC_TYPE",
    values: ["IMX95", "IMX952", "IMX8Q"],
}

soong_config_string_variable {
    name: "MEDIA_PIPELINE",
    values: ["NEOISP"],
}

IMXPLUGIN_cc_conditionals {
    name: "cc_conditionals_imx8_imx9",
    soong_config_variables: {
        BOARD_SOC_TYPE: {
            IMX8Q: {
                srcs: [
                    "src/v4l2/*.cpp",
                    "//vendor/nxp-opensource/imx/camera:RouteMediactl_src"
                ],
                include_dirs: [
                    "vendor/nxp-opensource/imx/camera/camera/include",
                ],
            },
            conditions_default: {
                cflags: ["-DUSE_LIBCAMERA"],
                srcs: [
                    "src/libcamera/*.cpp"
                ],
                shared_libs: [
                    "libcamera",
                    "libcamera-base",
                ],
                include_dirs: [
                    "vendor/nxp-opensource/libcamera/include",
                    "vendor/nxp-opensource/libcamera/prebuilt-android/include",
                    "vendor/nxp-opensource/libcamera/src/android",
                ],
            },
        }
    },
}

cc_binary {
    name: "android.hardware.automotive.evs@EvsEnumeratorHw",
    defaults: [
        "android.hardware.graphics.common-ndk_static",
        "cc_conditionals_imx8_imx9",
    ],
    vendor: true,
    relative_install_path: "hw",
    overrides: ["evsmanagerd"],
    srcs: [
        ":libgui_frame_event_aidl",
        "src/*.cpp"
    ],
    shared_libs: [
        "android.hardware.graphics.bufferqueue@1.0",
        "android.hardware.graphics.bufferqueue@2.0",
        "android.hidl.token@1.0-utils",
        "libEGL",
        "libGLESv2",
        "libbase",
        "libbinder_ndk",
        "libbufferqueueconverter",
        "libcamera_metadata",
        "libhardware_legacy",
        "libhidlbase",
        "liblog",
        "libnativewindow",
        "libtinyxml2",
        "libui",
        "libutils",
        "libyuv",
    ],
    static_libs: [
        "android.frameworks.automotive.display-V2-ndk",
        "android.hardware.automotive.evs-V2-ndk",
        "android.hardware.common-V2-ndk",
        "libaidlcommonsupport",
        "libcutils",
    ],
    header_libs: [
        "libgui_aidl_headers",
    ],
    local_include_dirs: [
        "include"
    ],
    include_dirs: [
        "frameworks/native/include/",
        "vendor/nxp-opensource/imx/display/display",
    ],
    cflags: [
        "-DLOG_TAG=\"EvsDriver\"",
        "-DGL_GLEXT_PROTOTYPES",
        "-DEGL_EGLEXT_PROTOTYPES",
        "-DISI_COLORSPACE=RGB888_1X24",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wthread-safety",
    ],
    required: [
        "fake_evs_aidl_configuration.xml",
    ],
    vintf_fragments: [
        "android.hardware.automotive.evs@EvsEnumeratorHw.xml",
    ],
}

prebuilt_etc {
    name: "fake_evs_aidl_configuration.xml",
    soc_specific: true,
    src: "resources/fake_evs_configuration.xml",
    sub_dir: "automotive/evs",
}

// The prebuilt_etc imx_evs_configuration.xml has been moved to device/nxp mek_8q, evk_95 and evk_952.
