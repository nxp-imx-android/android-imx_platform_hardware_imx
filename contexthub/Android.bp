cc_binary {
    name: "android.hardware.contexthub-service.imx",
    cpp_std: "c++20",
    defaults: [
        "//system/chre:contexthub_hal_defaults",
        "//system/chre:hidl_defaults",
    ],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "//system/chre:contexthub_hal_core",
        "service.cc",
        "imx_chre_connection.cc",
        "imx_context_hub.cc",
    ],
    shared_libs: [
        "libpower",
    ],
    static_libs: [
        "pw_detokenizer",
        "pw_polyfill",
        "pw_span",
        "pw_varint",
        "pw_base64",
        "chre_host_util",
    ],
    include_dirs: [
        "device/nxp/common/kernel-headers",
    ],
    init_rc: ["android.hardware.contexthub-service.imx.rc"],
    vintf_fragments: ["android.hardware.contexthub-service.imx.xml"],
}
